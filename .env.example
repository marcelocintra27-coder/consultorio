# Copie este arquivo para .env e gere uma chave local.
# Nunca coloque a chave real neste arquivo nem no Git.
#
# Gerar uma chave:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# Produção (Render): SECRET_KEY somente no Environment do serviço.
#
# Homologação local (NÃO usar em produção; NÃO versionar o .env):
# HOMOLOG_LOCAL=1
# DJANGO_MEDIA_ROOT=homolog_local/media
# EXAMES_ROOT=homolog_local/private_exames
# DJANGO_FILE_UPLOAD_TEMP_DIR=homolog_local/tmp
# Sem essas variáveis, o local continua em media/ e private_exames/.
# Com HOMOLOG_LOCAL=1 o Django exige o PostgreSQL consultorio_homolog e
# as pastas homolog_local/; caso contrário aborta na inicialização.

SECRET_KEY=
